            {
              "id": "mc_q_1",
              "prompt": "What is the standard form of a quadratic equation?",
              "options": [
                {
                  "id": "opt_1_1",
                  "text": "ax + b = 0",
                  "isCorrect": false
                },
                {
                  "id": "opt_1_2",
                  "text": "ax^2 + bx + c = 0",
                  "isCorrect": true
                },
                {
                  "id": "opt_1_3",
                  "text": "ax^3 + bx^2 + cx + d = 0",
                  "isCorrect": false
                },
                {
                  "id": "opt_1_4",
                  "text": "(a/x) + b = c",
                  "isCorrect": false
                }
              ],
              "explanation": ""
            },
            {
              "id": "mc_q_1787923119394_5z6",
              "prompt": "In the standard form of a quadratic equation (ax^2 + bx + c = 0), what restriction is placed on coefficient a?",
              "options": [
                {
                  "id": "opt_1787923119394_1",
                  "text": "a must be greater than 1",
                  "isCorrect": false
                },
                {
                  "id": "opt_1787923119394_2",
                  "text": "a must be an integer",
                  "isCorrect": false
                },
                {
                  "id": "opt_1787923119394_3",
                  "text": "a cannot be equal to 0",
                  "isCorrect": true
                },
                {
                  "id": "opt_1787923119394_4",
                  "text": "a must equal b",
                  "isCorrect": false
                }
              ],
              "explanation": ""
            },
            {
              "id": "mc_q_1787923144018_uds",
              "prompt": "What is the name of the U-shaped curve that represents the graph of a quadratic equation?",
              "options": [
                {
                  "id": "opt_1787923144018_1",
                  "text": "Hyperbola",
                  "isCorrect": false
                },
                {
                  "id": "opt_1787923144018_2",
                  "text": "Line",
                  "isCorrect": false
                },
                {
                  "id": "opt_1787923144018_3",
                  "text": "Circle",
                  "isCorrect": false
                },
                {
                  "id": "opt_1787923144018_4",
                  "text": "Parabola",
                  "isCorrect": true
                }
              ],
              "explanation": ""
            },
            {
              "id": "mc_q_1787923149562_cez",
              "prompt": "Which of the following solving methods is considered universal because it works for any quadratic equation, whether it can be factored or not?",
              "options": [
                {
                  "id": "opt_1787923149562_1",
                  "text": "Factoring",
                  "isCorrect": false
                },
                {
                  "id": "opt_1787923149562_2",
                  "text": "Graphing",
                  "isCorrect": false
                },
                {
                  "id": "opt_1787923149562_3",
                  "text": "The Quadratic Formula",
                  "isCorrect": true
                },
                {
                  "id": "opt_1787923149562_4",
                  "text": "Guess and check",
                  "isCorrect": false
                }
              ],
              "explanation": ""
            },
            {
              "id": "mc_q_1787923149962_u8v",
              "prompt": "When solving a quadratic equation by graphing, what do the solutions (or roots) of the equation correspond to on the graph?",
