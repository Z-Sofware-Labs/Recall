                {
                  "id": "opt_1787923149962_2",
                  "text": "The x-intercepts",
                  "isCorrect": true
                },
                {
                  "id": "opt_1787923149962_3",
                  "text": "The slope of the curve",
                  "isCorrect": false
                },
                {
                  "id": "opt_1787923149962_4",
