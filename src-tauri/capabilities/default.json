{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "dialog:default",
    "fs:default",
    "window-state:default",
    "process:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
